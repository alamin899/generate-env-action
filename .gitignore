# Environment files (we don't want to accidentally commit real .env files with secrets)
.env
.env.*
!.env.example

# Go build outputs (if you ever build the script locally)
/generate-env-action
/generate_env
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
